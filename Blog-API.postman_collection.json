{
  "info": {
    "_postman_id": "b1a6f2c0-3b2a-4b8a-9b5e-6d1e2c3a4f5b",
    "name": "Blog API",
    "description": "Auth + Post CRUD for the Blog API. Set the `base_url` collection variable if your server isn't on port 3030. Run the requests in each folder top to bottom the first time — the Login and Create Post requests auto-save `token`/`post_id` into collection variables that later requests reuse.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:3030", "type": "string" },
    { "key": "token", "value": "", "type": "string" },
    { "key": "token_b", "value": "", "type": "string" },
    { "key": "post_id", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register User A",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Alice\",\n  \"lastName\": \"Smith\",\n  \"userName\": \"alice1\",\n  \"email\": \"alice1@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/register", "host": ["{{base_url}}"], "path": ["api", "users", "register"] }
          }
        },
        {
          "name": "Login User A",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set(\"token\", data.token);",
                  "    console.log(\"Saved token to {{token}}\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"alice1@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/login", "host": ["{{base_url}}"], "path": ["api", "users", "login"] }
          }
        },
        {
          "name": "Logout User A",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{base_url}}/api/users/logout", "host": ["{{base_url}}"], "path": ["api", "users", "logout"] }
          }
        }
      ]
    },
    {
      "name": "Posts",
      "item": [
        {
          "name": "Create Post",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.post && data.post.id) {",
                  "    pm.collectionVariables.set(\"post_id\", data.post.id);",
                  "    console.log(\"Saved post_id to {{post_id}}\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"My first post\",\n  \"content\": \"Hello world\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts", "host": ["{{base_url}}"], "path": ["api", "posts"] }
          }
        },
        {
          "name": "List Posts",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/posts", "host": ["{{base_url}}"], "path": ["api", "posts"] }
          }
        },
        {
          "name": "Get Post By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["api", "posts", "{{post_id}}"] }
          }
        },
        {
          "name": "Update Post (PATCH)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Updated title\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["api", "posts", "{{post_id}}"] }
          }
        },
        {
          "name": "Delete Post",
          "request": {
            "method": "DELETE",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [],
            "url": { "raw": "{{base_url}}/api/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["api", "posts", "{{post_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Idempotency Demo",
      "item": [
        {
          "name": "1. Create With Idempotency-Key",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "demo-key-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Idempotent post\",\n  \"content\": \"Retrying this exact request should not create a duplicate.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts", "host": ["{{base_url}}"], "path": ["api", "posts"] }
          }
        },
        {
          "name": "2. Repeat Same Key + Same Body (expect same post, no duplicate)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "demo-key-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Idempotent post\",\n  \"content\": \"Retrying this exact request should not create a duplicate.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts", "host": ["{{base_url}}"], "path": ["api", "posts"] }
          }
        },
        {
          "name": "3. Repeat Same Key + Different Body (expect 409)",
          "request": {
            "method": "POST",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Idempotency-Key", "value": "demo-key-1" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"A different post\",\n  \"content\": \"This should be rejected since it reuses demo-key-1.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts", "host": ["{{base_url}}"], "path": ["api", "posts"] }
          }
        }
      ]
    },
    {
      "name": "Negative / Error Cases",
      "item": [
        {
          "name": "Create Post Without Token (expect 401)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Should fail\",\n  \"content\": \"No auth header sent.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts", "host": ["{{base_url}}"], "path": ["api", "posts"] }
          }
        },
        {
          "name": "Get Nonexistent Post (expect 404)",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{base_url}}/api/posts/999999", "host": ["{{base_url}}"], "path": ["api", "posts", "999999"] }
          }
        },
        {
          "name": "Register Duplicate Email (expect 409)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Someone\",\n  \"lastName\": \"Else\",\n  \"userName\": \"someoneelse\",\n  \"email\": \"alice1@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/register", "host": ["{{base_url}}"], "path": ["api", "users", "register"] }
          }
        },
        {
          "name": "Register User B",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Bob\",\n  \"lastName\": \"Jones\",\n  \"userName\": \"bob1\",\n  \"email\": \"bob1@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/register", "host": ["{{base_url}}"], "path": ["api", "users", "register"] }
          }
        },
        {
          "name": "Login User B",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const data = pm.response.json();",
                  "if (data.token) {",
                  "    pm.collectionVariables.set(\"token_b\", data.token);",
                  "    console.log(\"Saved token to {{token_b}}\");",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"bob1@example.com\",\n  \"password\": \"password123\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/users/login", "host": ["{{base_url}}"], "path": ["api", "users", "login"] }
          }
        },
        {
          "name": "Update User A's Post as User B (expect 403)",
          "request": {
            "method": "PATCH",
            "auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token_b}}", "type": "string" }] },
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Hijacked\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": { "raw": "{{base_url}}/api/posts/{{post_id}}", "host": ["{{base_url}}"], "path": ["api", "posts", "{{post_id}}"] }
          }
        }
      ]
    }
  ]
}
