NODE_ENV=development
PORT=3030
DB_NAME=blog_db
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# at least 32 random characters in production, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-me

# frontend origin(s) allowed by CORS, comma-separated
CLIENT_ORIGIN=http://localhost:5173

# number of reverse proxies in front of the app (1 on most hosting platforms, 0 when exposed directly).
# Needed so rate limiting sees the real client IP instead of the proxy's.
TRUST_PROXY=0

# pino level: fatal | error | warn | info | debug | trace | silent (default: info, silent in tests)
# LOG_LEVEL=info

# apply pending database migrations when the server starts.
# Defaults to true in development and false elsewhere (run `npm run migrate` as a deploy step instead).
# AUTO_MIGRATE=false

# frontend base URL: the verify-email and reset-password links in emails point here
APP_URL=http://localhost:5173

# console = print emails to the API log (dev only), smtp = send them (required in production)
# EMAIL_PROVIDER=console
EMAIL_FROM="Blog <no-reply@example.com>"
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_SECURE=false

# creating posts needs a verified email; set false until SMTP is configured
# REQUIRE_VERIFIED_EMAIL=true

# refresh-token cookie. Secure defaults to on in production. Use lax when the browser reaches the API
# on the same site as the frontend (e.g. through a /api proxy); none (needs Secure) only for cross-site setups.
# COOKIE_SAMESITE=lax
# COOKIE_SECURE=true

# image uploads. local = a folder served at /media (dev); s3 = any S3-compatible bucket such as
# Cloudflare R2 (required in production, along with all the S3_* values and STORAGE_PUBLIC_URL)
# STORAGE_PROVIDER=local
# STORAGE_LOCAL_DIR=uploads
# STORAGE_PUBLIC_URL=https://media.example.com
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=

# authors submit posts for an editor's approval before they go live. Set false to let authors publish directly.
# REQUIRE_POST_REVIEW=true

# the job that publishes scheduled posts (default on, except in tests)
# SCHEDULER_ENABLED=true
# SCHEDULER_INTERVAL_SECONDS=60

# which engine answers search queries. "mysql" uses the database's full-text indexes (the only engine for now).
# SEARCH_PROVIDER=mysql

# the job queue (notification emails, scheduled posts, image cleanup). Without REDIS_URL the jobs run inside
# the API process (fine for one instance, lost if it restarts mid-job). With it they go through BullMQ on Redis:
# retried, shared by several instances, and survive restarts. Local Redis: brew install redis && brew services start redis
# REDIS_URL=redis://127.0.0.1:6379
# QUEUE_PROVIDER=bullmq
# QUEUE_PREFIX=blog
# set false when jobs are processed by a separate `npm run worker` process
# WORKER_ENABLED=true

# reading analytics (views, readers, reads, referring sites): private by design, no cookies, no addresses stored.
# Set false to stop collecting (nothing already collected is removed).
# ANALYTICS_ENABLED=true

# search engines and link previews: crawler snapshots of public pages, sitemap.xml, robots.txt and RSS feeds.
# Every address in them is built from APP_URL. Set SEO_ENABLED=false to turn these endpoints off.
# SEO_ENABLED=true
# SITE_NAME=Genie's Entry
# SITE_TAGLINE=Essays, notes & dispatches
# SITE_DESCRIPTION=Essays, notes and dispatches — a small independent publication.
